    {
      "name": "Predictions",
      "description": "POST /api/predictions/{crime_id} — trigger synchronous prediction pipeline (ARCHITECTURE.md §6)\nGET  /api/predictions/{crime_id} — retrieve most recent prediction run\n\nReference: API_SPEC.md §/api/predictions/*  ADR-005 (6h window)  ADR-006 (alert thresholds)",
      "item": [
        {
          "name": "Trigger Prediction Pipeline",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "pm.test('Has crime_id', () => pm.expect(json).to.have.property('crime_id'));",
                  "pm.test('Has status',   () => pm.expect(json).to.have.property('status'));",
                  "pm.test('Has predictions array', () => pm.expect(json.predictions).to.be.an('array'));",
                  "pm.test('Status is valid enum',  () => {",
                  "  pm.expect(json.status).to.be.oneOf(['ok','insufficient_confidence','insufficient_evidence']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/predictions/{{crime_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "predictions", "{{crime_id}}"]
            }
          },
          "response": [
            {
              "name": "200 OK — prediction result",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"crime_id\": \"<uuid>\",\n  \"generated_at\": \"2026-09-18T10:00:00+00:00\",\n  \"model_version\": \"mock_rf_v1.0.0\",\n  \"status\": \"ok\",\n  \"predictions\": [\n    {\n      \"atm_id\": \"<uuid>\",\n      \"risk_score\": 0.82,\n      \"confidence\": 0.75,\n      \"predicted_window\": {\n        \"start\": \"2026-09-18T10:00:00+00:00\",\n        \"end\": \"2026-09-18T16:00:00+00:00\"\n      },\n      \"explanation\": [\n        { \"feature\": \"distance_from_crime\", \"value\": 0.45, \"contribution\": \"high\" },\n        { \"feature\": \"atm_historical_risk\", \"value\": 0.72, \"contribution\": \"high\" }\n      ]\n    }\n  ]\n}"
            },
            {
              "name": "200 OK — insufficient_confidence",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"crime_id\": \"<uuid>\",\n  \"generated_at\": \"2026-09-18T10:00:00+00:00\",\n  \"model_version\": \"mock_rf_v1.0.0\",\n  \"status\": \"insufficient_confidence\",\n  \"predictions\": []\n}"
            },
            {
              "name": "404 Crime Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"error\": {\n    \"code\": \"HTTP_404\",\n    \"message\": \"Crime incident not found\",\n    \"details\": {}\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Latest Prediction for Crime",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const code = pm.response.code;",
                  "pm.test('Status 200 or 404', () => pm.expect(code).to.be.oneOf([200, 404]));",
                  "if (code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Has crime_id', () => pm.expect(json).to.have.property('crime_id'));",
                  "  pm.test('Has status',   () => pm.expect(json).to.have.property('status'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
